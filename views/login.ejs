<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <%- include('head') %>
  </head>
  <body>
    <div class="container" id="content" style="display: none">
      <h1>Login</h1>
      <p>Authentication is required to access <span id="area">this area</span></p>
      <form id="loginForm" method="POST" action="/login">
        <% if (useUsername) { %>
          <input
            type="text"
            name="username"
            id="username"
            placeholder="Enter your username"
            autocomplete="username"
            required
          />
        <% } %>
        <input
          type="password"
          name="password"
          id="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        />
        <button type="submit" id="login">Login</button>
      </form>
      <p id="message"></p>
    </div>

    <script>
      // make content visible, hidden by default, <noscript> content will show error message for non-JS browsers.
      const content = document.getElementById('content');
      content.style.display = 'block';

      // change title
      document.title = 'Log in to ' + location.host;

      document.getElementById('area').innerText = location.host;
      const usernameInput = document.getElementById('username');
      const passwordInput = document.getElementById('password');
      const messageEl = document.getElementById('message');

      const loginForm = document.getElementById('loginForm');

      // post credentials to /login
      const submitLogin = (username, password) => {
        fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password }),
        })
          .then((response) => {
            // check for auth failure for rejected credentials
            if (response.status === 401) return false;

            // check for auth failure for other reasons
            if (response.status !== 200) return false;

            // auth okay
            return response.json();
          })
          .then((data) => {
            if (data && data.status === 'ok') {
              // auth success, cookie should be set
              const redirect = '<%= referer %>';
              window.location.href = redirect && redirect !== '/'
                ? '/logged-in?redirect=' + encodeURIComponent(redirect)
                : '/logged-in';
              return;
            }

            // auth failure, give feedback to user
            messageEl.innerText = 'Authentication failed';
          });
      };

      // handle form submit (catches button click AND Enter key)
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const username = usernameInput ? usernameInput.value : undefined;
        const password = passwordInput.value;

        // clear password after capturing value (but keep fields visible for password managers)
        passwordInput.value = '';

        submitLogin(username, password);
      });

      // focus first field
      if (usernameInput) {
        usernameInput.focus();
      } else {
        passwordInput.focus();
      }
    </script>
  </body>
</html>
